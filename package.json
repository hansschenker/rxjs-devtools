{
  "name": "@hansschenker/rxjs-devtools",
  "version": "0.1.0",
  "description": "Redux DevTools instrumentation for RxJS: time travel, action skipping and stream inspection for scan-based state and any observable. A framework-less port of the @ngrx/store-devtools lifted-state architecture.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "vite demo --open",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "rxjs",
    "devtools",
    "redux-devtools",
    "time-travel",
    "debugging",
    "observable",
    "scan",
    "ngrx"
  ],
  "author": "Hans Schenker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansschenker/rxjs-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/hansschenker/rxjs-devtools/issues"
  },
  "homepage": "https://github.com/hansschenker/rxjs-devtools#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
